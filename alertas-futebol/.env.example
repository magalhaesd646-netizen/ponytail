# --- API de dados de futebol ao vivo (obrigatório) ---
# Este app usa a API-Football (api-sports.io / RapidAPI) para buscar
# partidas ao vivo e estatísticas (chutes, escanteios, posse de bola...).
# Crie uma conta gratuita em https://www.api-football.com/ (plano free dá
# uma cota diária de requisições — veja "Limites da API" no README) e pegue
# sua chave em https://dashboard.api-football.com/.
FOOTBALL_API_KEY=

# 'direct' (padrão) usa v3.football.api-sports.io direto com a chave acima.
# 'rapidapi' usa a mesma API via RapidAPI (api-football-v1.p.rapidapi.com) —
# use esse valor se você assinou o plano pelo RapidAPI em vez do site direto.
FOOTBALL_API_PROVIDER=direct

# Trava de segurança: no máximo N partidas ao vivo processadas por rodada
# do monitor, para não estourar a cota diária da API quando houver muitos
# jogos simultâneos.
MAX_FIXTURES_PER_RUN=15

# Intervalo do monitor quando rodando via `npm start` (servidor local
# ligado). Sintaxe de cron. Ignorado no modo GitHub Actions (o intervalo lá
# é o do arquivo .github/workflows/alertas-futebol.yml).
MONITOR_CRON=*/3 * * * *

# --- Canal de notificação: e-mail (opcional, mas configure pelo menos um
# canal — e-mail e/ou webhook abaixo — ou os alertas não chegam a
# lugar nenhum) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_NAME=Alertas de Futebol
ALERT_EMAIL_TO=

# --- Canal de notificação: webhook (opcional) ---
# Aceita um webhook de entrada do Discord ou do Slack (a mensagem é
# enviada com os campos "content" e "text" ao mesmo tempo, então funciona
# nos dois sem configuração extra).
ALERT_WEBHOOK_URL=

# Porta do servidor local (interface web).
PORT=3001
