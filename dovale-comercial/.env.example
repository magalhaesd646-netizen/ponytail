# --- Conta de e-mail usada para os disparos (Titan Email) ---
# 1. Entre no webmail do Titan (https://webmail.titan.email ou o link que
#    seu provedor de hospedagem oferece) como danilo.magalhaes@dovaleengenharia.com
#    e em Configurações → verifique/ative o "Acesso de terceiros" (third-party
#    app access) — sem isso o SMTP recusa a conexão mesmo com a senha certa.
# 2. O Titan bloqueia apps de terceiros enquanto a verificação em duas etapas
#    da CONTA DO TITAN (não a do Google) estiver ativa — desative-a se
#    estiver usando.
# 3. SMTP_PASS é a senha normal da caixa de e-mail (o Titan não usa "senha
#    de app" como o Google).
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=danilo.magalhaes@dovaleengenharia.com
SMTP_PASS=

# Nome que aparece como remetente (o e-mail continua sendo o SMTP_USER acima).
FROM_NAME=Danilo Magalhães - Dovale Engenharia

# Assinatura simples adicionada ao fim de cada e-mail (opcional, texto puro).
EMAIL_SIGNATURE=Danilo Magalhães\nDovale Engenharia\ndovaleengenharia.com

# Intervalo mínimo entre e-mails de um mesmo disparo, em milissegundos.
# Evita que o provedor marque os envios como spam/atividade suspeita.
SEND_DELAY_MS=4000

# Limite de e-mails por disparo (proteção extra contra disparo em massa
# acidental; ajuste conforme o limite do seu plano Titan).
SEND_DAILY_LIMIT=400

# Porta do servidor local (interface web).
PORT=3000
