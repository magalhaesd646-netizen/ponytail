# --- Conta Gmail usada para os disparos ---
# Use uma "senha de app" do Google, não a senha normal da conta:
# https://myaccount.google.com/apppasswords (precisa ter a verificação em
# duas etapas ativada na conta danilo.magalhaes@dovaleengenharia.com).
GMAIL_USER=danilo.magalhaes@dovaleengenharia.com
GMAIL_APP_PASSWORD=

# Nome que aparece como remetente (o e-mail continua sendo o GMAIL_USER acima).
FROM_NAME=Danilo Magalhães - Dovale Engenharia

# Assinatura simples adicionada ao fim de cada e-mail (opcional, texto puro).
EMAIL_SIGNATURE=Danilo Magalhães\nDovale Engenharia\ndovaleengenharia.com

# Intervalo mínimo entre e-mails de um mesmo disparo, em milissegundos.
# Evita que o Gmail marque os envios como spam/atividade suspeita.
SEND_DELAY_MS=4000

# Limite de e-mails por disparo (proteção extra; Gmail pessoal permite até
# ~500/dia, Google Workspace até ~2000/dia).
SEND_DAILY_LIMIT=400

# Porta do servidor local (interface web).
PORT=3000
