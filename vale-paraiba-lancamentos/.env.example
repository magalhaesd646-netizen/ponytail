# --- Busca web (recomendado: escolha UM dos dois provedores abaixo) ---
# Sem nenhum dos dois, o app roda só com os portais públicos (modo
# zero-config) — mas atenção: no ambiente do GitHub Actions, Viva Real e ZAP
# costumam bloquear as requisições (HTTP 403), então um destes dois é o que
# de fato faz o app achar lançamentos de verdade hoje em dia.

# Opção A (recomendada, setup mais simples): Tavily — só uma chave, sem
# precisar criar projeto no Google Cloud. Plano grátis: 1.000 créditos/mês,
# sem cartão de crédito. Crie a chave em https://app.tavily.com/
TAVILY_API_KEY=

# Opção B: Google Custom Search API (Programmable Search Engine) — setup em
# duas etapas (chave de API + mecanismo de busca). Cota grátis: 100/dia.
# Crie a chave em https://console.cloud.google.com/apis/credentials e um
# mecanismo de busca "buscar em toda a web" em https://programmablesearchengine.google.com/
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Limite de segurança de buscas/dia, independente do provedor (padrão 30,
# seguro para o plano grátis do Tavily rodando todo dia; se só usar o
# Google, pode subir até 90-100).
SEARCH_DAILY_QUERY_BUDGET=30

# --- Envio de e-mail (SMTP) — opcional, além da Issue de alerta padrão ---
# Para Gmail, use uma "senha de app" (não a senha normal da conta):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# --- Cidades pesquisadas (opcional) ---
# Lista separada por vírgula. Se não definido, usa todos os municípios do
# Vale do Paraíba Paulista (ver src/config.js), com São José dos Campos,
# Jacareí e Taubaté priorizados.
# VALE_CITIES=São José dos Campos,Jacareí,Taubaté
